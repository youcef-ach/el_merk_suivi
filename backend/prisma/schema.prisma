datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  VIEWER
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum ProcessingStatus {
  PENDING
  READY
  FAILED
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  password          String
  role              Role     @default(VIEWER)
  createdAt         DateTime @default(now())
  createdTours      Tour[]   @relation("TourCreator")
  authorizedTours   Tour[]   @relation("AuthorizedViewers")
}

model Tour {
  id                String       @id @default(uuid())
  title             String
  description       String?
  glbModelUrl       String?
  scansJsonUrl      String?
  visibility        Visibility   @default(PRIVATE)
  
  creatorId         String
  creator           User         @relation("TourCreator", fields: [creatorId], references: [id])
  authorizedViewers User[]       @relation("AuthorizedViewers")
  
  panoramas         Panorama[]
  tags              Tag[]
  scans             Scan[]
  areaPointers      AreaPointer[]
  
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model Panorama {
  id       String           @id @default(uuid())
  imageUrl String
  status   ProcessingStatus @default(PENDING)
  tourId   String
  tour     Tour             @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model Tag {
  id          String        @id @default(uuid())
  title       String
  description String?
  posX        Float
  posY        Float
  posZ        Float
  icon        String        @default("info")
  color       String        @default("#00e5ff")
  size        Float         @default(1.0)
  tourId      String
  tour        Tour          @relation(fields: [tourId], references: [id], onDelete: Cascade)
  documents   TagDocument[]
}

model TagDocument {
  id      String @id @default(uuid())
  title   String
  fileUrl String
  tagId   String
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
}

model Scan {
  id         String @id @default(uuid())
  posX       Float
  posY       Float
  posZ       Float
  quatW      Float
  quatX      Float
  quatY      Float
  quatZ      Float
  
  // Teleport Graph
  targetScanId String?
  targetScan   Scan?   @relation("ScanTeleports", fields: [targetScanId], references: [id])
  incomingTeleports Scan[] @relation("ScanTeleports")

  tourId     String
  tour       Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model AreaPointer {
  id         String   @id @default(uuid())
  name       String
  color      String   @default("#ff0000")
  posX       Float
  posY       Float
  posZ       Float
  height     Float    @default(15.0)
  thickness  Float    @default(0.04)
  labelSize  Float    @default(1.0)
  
  tourId     String
  tour       Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
